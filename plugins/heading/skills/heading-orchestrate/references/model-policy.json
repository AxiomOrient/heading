{
  "schemaVersion": 1,
  "policyVersion": "2026-09-08.1",
  "verifiedOn": "2026-09-08",
  "status": "CANDIDATE_NOT_BENCHMARKED",
  "sources": {
    "astra": "https://developers.openai.com/api/docs/models/gpt-6-astra",
    "luna": "https://developers.openai.com/api/docs/models/gpt-5.6-luna",
    "selection": "https://developers.openai.com/codex/models",
    "precedence": "https://developers.openai.com/codex/subagents",
    "nativeEfforts": "https://learn.chatgpt.com/docs/agent-configuration/subagents#choosing-models-and-reasoning"
  },
  "models": {
    "gpt-6-astra": [
      "low",
      "medium",
      "ultra"
    ],
    "gpt-5.6-luna": [
      "none",
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ]
  },
  "routes": {
    "astra-low": {
      "model": "gpt-6-astra",
      "effort": "low"
    },
    "astra-medium": {
      "model": "gpt-6-astra",
      "effort": "medium"
    },
    "luna-xhigh": {
      "model": "gpt-5.6-luna",
      "effort": "xhigh"
    },
    "luna-max": {
      "model": "gpt-5.6-luna",
      "effort": "max"
    },
    "astra-ultra": {
      "model": "gpt-6-astra",
      "effort": "ultra"
    }
  },
  "defaults": {
    "lead": "astra-low",
    "easy": "luna-xhigh",
    "hard": "astra-low",
    "critical": "astra-medium"
  },
  "astraLadder": [
    "astra-low",
    "astra-medium",
    "astra-ultra"
  ],
  "lunaRetry": "luna-max",
  "uiEffortAliases": {
    "light": "low",
    "extra high": "xhigh"
  },
  "maxReasoningFailuresPerRoute": 1,
  "nonReasoningFailures": [
    "environment",
    "permission",
    "transient"
  ],
  "facts": {
    "clarity": [
      "clear",
      "uncertain"
    ],
    "scope": [
      "local",
      "cross-boundary",
      "unknown"
    ],
    "oracle": [
      "strong",
      "weak",
      "unknown"
    ],
    "risk": [
      "routine",
      "material",
      "critical",
      "unknown"
    ]
  }
}
